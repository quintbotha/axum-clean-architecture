DATABASE_URL=postgres://user:password@localhost/clean_architecture
RUST_LOG="clean_architecture=debug,tower_http=debug,sqlx=warn"
REFRESH_TOKEN_TTL_DAYS="30"
ACCESS_TOKEN_TTL_SECS="900"
JWT_SECRET=replace_this_with_a_random_secret
# Set to "false" only for local HTTP-only dev; the refresh-token cookie needs
# Secure=true to be sent by browsers over HTTPS in any real deployment.
COOKIE_SECURE="true"
